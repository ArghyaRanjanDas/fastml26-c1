    "n_particles": 16,
    "particle_channels": [
      {
        "index": 0,
        "name": "log_pt",
        "formula": "log1p(pt) / 8"
      },
      {
        "index": 1,
        "name": "eta",
        "formula": "eta / 4"
      },
      {
        "index": 2,
        "name": "dxy",
        "formula": "clip(dxy, -2, 2) / 2"
      },
      {
        "index": 3,
        "name": "cos_phi",
        "formula": "cos(phi)"
      },
      {
        "index": 4,
        "name": "sin_phi",
        "formula": "sin(phi)"
      },
      {
        "index": 5,
        "name": "lnz",
        "formula": "log(max(pt,1e-6) / HT) / 4      # HT = sum of pt over the kept candidates"
      },
      {
        "index": 6,
        "name": "lnE",
        "formula": "log1p(pt * cosh(eta)) / 8"
      },
      {
        "index": 7,
        "name": "cos_dphi_lead",
        "formula": "cos(dphi(phi, phi_lead))        # dphi wrapped to (-pi, pi]"
      },
      {
        "index": 8,
        "name": "sin_dphi_lead",
        "formula": "sin(dphi(phi, phi_lead))"
      },
      {
        "index": 9,
        "name": "deta_lead",
        "formula": "(eta - eta_lead) / 2"
      },
      {
        "index": 10,
        "name": "abs_dxy",
        "formula": "abs(clip(dxy, -2, 2) / 2)"
      }
    ],
